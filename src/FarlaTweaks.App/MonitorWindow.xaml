<Window x:Class="FarlaTweaks.App.MonitorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        AllowsTransparency="True"
        Background="Transparent"
        Width="930"
        Height="620"
        WindowStartupLocation="CenterOwner">
    <Border Background="{StaticResource FarlaBackground}" BorderBrush="{StaticResource FarlaBorder}" BorderThickness="1" CornerRadius="14">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="70" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" MouseLeftButtonDown="DragArea_OnMouseLeftButtonDown">
                <StackPanel VerticalAlignment="Center" Margin="26,0,0,0">
                    <TextBlock Text="MONITOR" Foreground="{StaticResource FarlaText}" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock Text="Live system telemetry. Farla does not change settings from this view." Foreground="{StaticResource FarlaMuted}" FontSize="12" Margin="0,3,0,0" />
                </StackPanel>
                <Button Content="×" Width="42" Height="32" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0" Style="{StaticResource NavButtonStyle}" Click="CloseButton_OnClick" />
            </Grid>
            <Grid Grid.Row="1" Margin="26,10,26,26">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <UniformGrid Rows="1" Columns="3" Margin="0,0,0,18">
                    <Border Background="{StaticResource FarlaSurface}" BorderBrush="{StaticResource FarlaBorder}" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,10,0">
                        <StackPanel>
                            <TextBlock Text="CPU" Foreground="{StaticResource FarlaMuted}" FontSize="10" FontWeight="SemiBold" />
                            <TextBlock x:Name="CpuText" Text="--" Foreground="{StaticResource FarlaText}" FontSize="24" FontWeight="SemiBold" Margin="0,6,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Background="{StaticResource FarlaSurface}" BorderBrush="{StaticResource FarlaBorder}" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,10,0">
                        <StackPanel>
                            <TextBlock Text="MEMORY" Foreground="{StaticResource FarlaMuted}" FontSize="10" FontWeight="SemiBold" />
                            <TextBlock x:Name="MemoryText" Text="--" Foreground="{StaticResource FarlaText}" FontSize="24" FontWeight="SemiBold" Margin="0,6,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Background="{StaticResource FarlaSurface}" BorderBrush="{StaticResource FarlaBorder}" BorderThickness="1" CornerRadius="10" Padding="16">
                        <StackPanel>
                            <TextBlock Text="GPU" Foreground="{StaticResource FarlaMuted}" FontSize="10" FontWeight="SemiBold" />
                            <TextBlock x:Name="GpuText" Text="--" Foreground="{StaticResource FarlaText}" FontSize="24" FontWeight="SemiBold" Margin="0,6,0,0" />
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <Border Grid.Row="1" Background="{StaticResource FarlaSurface}" BorderBrush="{StaticResource FarlaBorder}" BorderThickness="1" CornerRadius="10" Padding="16">
                    <Grid>
                        <Canvas x:Name="GraphCanvas" Height="280" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="Transparent" />
                        <TextBlock Text="100%" Foreground="{StaticResource FarlaMuted}" FontSize="9" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0,2,4,0" />
                        <TextBlock Text="0%" Foreground="{StaticResource FarlaMuted}" FontSize="9" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0,0,4,2" />
                    </Grid>
                </Border>

                <Grid Grid.Row="2" Margin="0,16,0,0">
                    <TextBlock x:Name="StatusText" Text="Monitoring" Foreground="{StaticResource FarlaMuted}" FontSize="12" VerticalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Ellipse Width="6" Height="6" Fill="{StaticResource FarlaSuccess}" Margin="0,6,7,0" />
                        <TextBlock Text="LIVE" Foreground="{StaticResource FarlaMuted}" FontSize="10" FontWeight="SemiBold" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
