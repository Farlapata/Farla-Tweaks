<Window x:Class="FarlaTweaks.App.SetupWizard"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        AllowsTransparency="True"
        Background="Transparent"
        Width="920"
        Height="620"
        WindowStartupLocation="CenterOwner">
    <Border Background="{StaticResource FarlaBackground}" BorderBrush="{StaticResource FarlaBorder}" BorderThickness="1" CornerRadius="16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="68" />
                <RowDefinition Height="*" />
                <RowDefinition Height="72" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" MouseLeftButtonDown="DragArea_OnMouseLeftButtonDown">
                <TextBlock Text="FARLA / SETUP WIZARD" Foreground="{StaticResource FarlaText}" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" Margin="24,0,0,0" />
                <Button Content="×" Width="42" Height="32" HorizontalAlignment="Right" Margin="0,0,12,0" Style="{StaticResource NavButtonStyle}" Click="CloseButton_OnClick" />
            </Grid>

            <Grid Grid.Row="1" Margin="42,28">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <TextBlock x:Name="StepLabel" Text="01 / 03" Foreground="{StaticResource FarlaMuted}" FontSize="12" FontWeight="SemiBold" />
                    <TextBlock x:Name="TitleText" Text="Tell Farla how you use your PC." Foreground="{StaticResource FarlaText}" FontSize="28" FontWeight="SemiBold" Margin="0,8,0,0" />
                    <TextBlock x:Name="SubtitleText" Text="Your answers shape which optimizations Farla considers." Foreground="{StaticResource FarlaMuted}" FontSize="14" Margin="0,7,0,0" />
                </StackPanel>

                <Grid Grid.Row="1" Margin="0,28,0,0">
                    <StackPanel x:Name="Step1Panel">
                        <TextBlock Text="Primary use" Foreground="{StaticResource FarlaText}" FontSize="13" />
                        <WrapPanel Margin="0,14,0,0">
                            <CheckBox x:Name="CompetitiveGamingBox" Content="Competitive gaming" Style="{StaticResource WizardCheckBoxStyle}" />
                            <CheckBox x:Name="StreamingBox" Content="Streaming" Style="{StaticResource WizardCheckBoxStyle}" />
                            <CheckBox x:Name="CreationBox" Content="Creation" Style="{StaticResource WizardCheckBoxStyle}" />
                        </WrapPanel>

                        <TextBlock Text="Primary game" Foreground="{StaticResource FarlaText}" FontSize="13" Margin="0,26,0,0" />
                        <ComboBox x:Name="GameBox" Width="280" HorizontalAlignment="Left" Margin="0,12,0,0">
                            <ComboBoxItem Content="Fortnite" IsSelected="True" />
                            <ComboBoxItem Content="Valorant" />
                            <ComboBoxItem Content="CS2" />
                            <ComboBoxItem Content="Minecraft" />
                            <ComboBoxItem Content="Other" />
                        </ComboBox>
                    </StackPanel>

                    <StackPanel x:Name="Step2Panel" Visibility="Collapsed">
                        <TextBlock Text="Software dependencies" Foreground="{StaticResource FarlaText}" FontSize="13" />
                        <WrapPanel Margin="0,14,0,0">
                            <CheckBox x:Name="CrosshairBox" Content="Crosshair X" Style="{StaticResource WizardCheckBoxStyle}" />
                            <CheckBox x:Name="DiscordBox" Content="Discord overlay" Style="{StaticResource WizardCheckBoxStyle}" />
                            <CheckBox x:Name="ObsBox" Content="OBS" Style="{StaticResource WizardCheckBoxStyle}" />
                            <CheckBox x:Name="OutplayedBox" Content="Outplayed / recording" Style="{StaticResource WizardCheckBoxStyle}" />
                            <CheckBox x:Name="AfterburnerBox" Content="MSI Afterburner" Style="{StaticResource WizardCheckBoxStyle}" />
                            <CheckBox x:Name="WallpaperEngineBox" Content="Wallpaper Engine" Style="{StaticResource WizardCheckBoxStyle}" />
                        </WrapPanel>

                        <Border Background="{StaticResource FarlaSurfaceAlt}" BorderBrush="{StaticResource FarlaBorder}" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,28,0,0">
                            <TextBlock Text="Farla uses this information to avoid incompatible optimizations. For example, Crosshair X relies on Xbox Game Bar, so Farla will not blindly disable a component your setup needs." Foreground="{StaticResource FarlaMuted}" TextWrapping="Wrap" FontSize="13" />
                        </Border>
                    </StackPanel>

                    <StackPanel x:Name="Step3Panel" Visibility="Collapsed">
                        <TextBlock Text="Your first Farla plan" Foreground="{StaticResource FarlaMuted}" FontSize="12" />
                        <TextBlock x:Name="PlanSummary" Text="Building your personalized plan..." Foreground="{StaticResource FarlaText}" FontSize="22" Margin="0,10,0,0" />
                        <ItemsControl x:Name="PlanItems" Margin="0,18,0,0" />
                    </StackPanel>
                </Grid>
            </Grid>

            <Grid Grid.Row="2" Margin="42,0">
                <Button x:Name="BackButton" Content="Back" Style="{StaticResource NavButtonStyle}" HorizontalAlignment="Left" Click="BackButton_OnClick" Visibility="Collapsed" />
                <Button x:Name="NextButton" Content="Continue" Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Right" Click="NextButton_OnClick" />
            </Grid>
        </Grid>
    </Border>
</Window>
