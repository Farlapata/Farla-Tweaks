<Window x:Class="FarlaTweaks.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Farla Tweaks"
        Width="1180"
        Height="760"
        Background="{StaticResource NovaBackground}">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="GOOD AFTERNOON, MATHÉO" Foreground="{StaticResource NovaText}" FontSize="28" FontWeight="SemiBold" />
            <TextBlock Text="Your PC is ready." Foreground="{StaticResource NovaMuted}" FontSize="15" Margin="0,6,0,0" />
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,30,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.1*" />
                <ColumnDefinition Width="1.4*" />
            </Grid.ColumnDefinitions>

            <Border Background="{StaticResource NovaSurface}" CornerRadius="18" Padding="28" Margin="0,0,14,0">
                <StackPanel>
                    <TextBlock Text="NOVA SCORE" Foreground="{StaticResource NovaMuted}" FontSize="13" FontWeight="SemiBold" />
                    <TextBlock Text="--" Foreground="{StaticResource NovaText}" FontSize="76" FontWeight="Bold" Margin="0,10,0,8" />
                    <TextBlock Text="We'll calculate your score after the first system scan." Foreground="{StaticResource NovaMuted}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <StackPanel Grid.Column="1">
                <Border Background="{StaticResource NovaSurface}" CornerRadius="18" Padding="24" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="YOUR NOVA BRIEFING" Foreground="{StaticResource NovaText}" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Text="No system scan has run yet." Foreground="{StaticResource NovaMuted}" Margin="0,8,0,0" />
                        <Button Content="START SETUP WIZARD" Margin="0,20,0,0" Padding="18,10" HorizontalAlignment="Left" />
                    </StackPanel>
                </Border>

                <Border Background="{StaticResource NovaSurface}" CornerRadius="18" Padding="24">
                    <StackPanel>
                        <TextBlock Text="NOVA COPILOT" Foreground="{StaticResource NovaText}" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Text="● Waiting for your first setup." Foreground="{StaticResource NovaMuted}" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
