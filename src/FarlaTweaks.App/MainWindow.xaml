<Window x:Class="FarlaTweaks.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="True"
        AllowsTransparency="True"
        Background="Transparent"
        Width="1180"
        Height="760"
        MinWidth="1180"
        MinHeight="760"
        MaxWidth="1180"
        MaxHeight="760"
        WindowStartupLocation="CenterScreen">
    <Border Background="{StaticResource FarlaBackground}"
            BorderBrush="{StaticResource FarlaBorder}"
            BorderThickness="1">
        <Grid MouseLeftButtonDown="WindowDragArea_OnMouseLeftButtonDown">
            <Grid.RowDefinitions>
                <RowDefinition Height="68" />
                <RowDefinition Height="48" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="240" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="140" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="28,0,0,0">
                    <TextBlock Text="FARLA" Foreground="{StaticResource FarlaText}" FontSize="21" FontWeight="SemiBold" />
                    <TextBlock Text=" / TWEAKS" Foreground="{StaticResource FarlaMuted}" FontSize="12" VerticalAlignment="Bottom" Margin="6,0,0,3" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0">
                    <Button Content="−" Width="38" Height="30" Style="{StaticResource NavButtonStyle}" ToolTip="Minimize" Click="MinimizeButton_OnClick" />
                    <Button Content="×" Width="38" Height="30" Style="{StaticResource NavButtonStyle}" ToolTip="Close" Click="CloseButton_OnClick" />
                </StackPanel>
            </Grid>

            <Border Grid.Row="1" Background="#0D1015" BorderBrush="{StaticResource FarlaBorder}" BorderThickness="0,1,0,1">
                <Grid Margin="22,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Content="Overview" Style="{StaticResource ActiveNavButtonStyle}" />
                    <Button Grid.Column="1" Content="Optimize" Style="{StaticResource NavButtonStyle}" Click="OptimizeButton_OnClick" />
                    <Button Grid.Column="2" Content="Games" Style="{StaticResource NavButtonStyle}" />
                    <Button Grid.Column="3" Content="Monitor" Style="{StaticResource NavButtonStyle}" />
                    <Button Grid.Column="4" Content="History" Style="{StaticResource NavButtonStyle}" Click="HistoryButton_OnClick" />
                    <Button Grid.Column="5" Content="Settings" Style="{StaticResource NavButtonStyle}" />
                    <StackPanel Grid.Column="6" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,4,0">
                        <Ellipse Width="6" Height="6" Fill="{StaticResource FarlaSuccess}" Margin="0,0,7,0" />
                        <TextBlock Text="PROTECTED" Foreground="{StaticResource FarlaMuted}" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Hidden">
                <StackPanel Margin="56,34,56,42">
                    <TextBlock x:Name="GreetingText" Foreground="{StaticResource FarlaText}" FontSize="32" FontWeight="SemiBold" />
                    <TextBlock x:Name="SubtitleText" Text="Your PC is ready" Foreground="{StaticResource FarlaMuted}" FontSize="15" Margin="0,5,0,30" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.45*" />
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="0.9*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="#0D1015" BorderBrush="{StaticResource FarlaBorder}" BorderThickness="1" Padding="26">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="190" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="FARLA SCORE" Foreground="{StaticResource FarlaMuted}" FontSize="10" FontWeight="SemiBold" />
                                    <TextBlock x:Name="ScoreText" Text="--" Foreground="{StaticResource FarlaText}" FontSize="58" FontWeight="Bold" Margin="0,10,0,0" />
                                    <TextBlock x:Name="ScoreStatusText" Text="NOT ANALYZED" Foreground="{StaticResource FarlaMuted}" FontSize="11" FontWeight="SemiBold" />
                                    <TextBlock x:Name="ScoreDescriptionText" Text="Run a read-only analysis to calculate your current system state." Foreground="{StaticResource FarlaMuted}" FontSize="12" TextWrapping="Wrap" Margin="0,10,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="28,0,0,0">
                                    <TextBlock Text="SYSTEM PROFILE" Foreground="{StaticResource FarlaMuted}" FontSize="10" FontWeight="SemiBold" Margin="0,0,0,14" />
                                    <StackPanel Margin="0,0,0,10">
                                        <TextBlock Text="MEMORY" Foreground="{StaticResource FarlaMuted}" FontSize="9" />
                                        <TextBlock x:Name="PerformanceValueText" Text="--" Foreground="{StaticResource FarlaText}" FontSize="15" Margin="0,3,0,0" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,0,10">
                                        <TextBlock Text="ARCHITECTURE" Foreground="{StaticResource FarlaMuted}" FontSize="9" />
                                        <TextBlock x:Name="StabilityValueText" Text="--" Foreground="{StaticResource FarlaText}" FontSize="15" Margin="0,3,0,0" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,0,10">
                                        <TextBlock Text="GRAPHICS" Foreground="{StaticResource FarlaMuted}" FontSize="9" />
                                        <TextBlock x:Name="GamingValueText" Text="--" Foreground="{StaticResource FarlaText}" FontSize="15" Margin="0,3,0,0" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="WINDOWS" Foreground="{StaticResource FarlaMuted}" FontSize="9" />
                                        <TextBlock x:Name="NetworkValueText" Text="--" Foreground="{StaticResource FarlaText}" FontSize="15" Margin="0,3,0,0" />
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Grid.Column="2" Background="#0D1015" BorderBrush="{StaticResource FarlaBorder}" BorderThickness="1" Padding="24">
                            <StackPanel>
                                <TextBlock Text="PRIMARY ACTION" Foreground="{StaticResource FarlaMuted}" FontSize="10" FontWeight="SemiBold" />
                                <TextBlock Text="Understand your PC" Foreground="{StaticResource FarlaText}" FontSize="25" FontWeight="SemiBold" Margin="0,12,0,4" />
                                <TextBlock x:Name="AnalysisDescriptionText" Text="The first analysis is read-only. Farla won't change anything." Foreground="{StaticResource FarlaMuted}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,20" />
                                <Button x:Name="StartAnalysisButton" Content="START ANALYSIS" Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Left" Click="StartAnalysisButton_OnClick" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Grid Margin="0,30,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="FARLA COPILOT" Foreground="{StaticResource FarlaText}" FontSize="16" FontWeight="SemiBold" />
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Ellipse Width="6" Height="6" Fill="{StaticResource FarlaSuccess}" Margin="0,4,8,0" />
                                <TextBlock x:Name="CopilotStatusText" Text="Waiting for your first system analysis." Foreground="{StaticResource FarlaMuted}" FontSize="12" />
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                            <TextBlock x:Name="RecommendationEyebrowText" Text="NEXT STEP" Foreground="{StaticResource FarlaMuted}" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Right" />
                            <TextBlock x:Name="RecommendationTitleText" Text="Analyze first, optimize second." Foreground="{StaticResource FarlaText}" FontSize="14" HorizontalAlignment="Right" Margin="0,7,0,0" />
                            <Button Content="OPEN OPTIMIZE" Style="{StaticResource NavButtonStyle}" HorizontalAlignment="Right" Margin="0,7,0,0" Click="OptimizeButton_OnClick" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
