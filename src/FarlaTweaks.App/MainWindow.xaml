<Window x:Class="FarlaTweaks.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Farla Tweaks"
        Width="1280"
        Height="760"
        MinWidth="1000"
        MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}"
        Foreground="{StaticResource TextBrush}">
    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="24" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid>
            <StackPanel>
                <TextBlock Text="FARLA" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" />
                <TextBlock Text="Good evening, Mathéo" FontSize="34" FontWeight="SemiBold" Margin="0,6,0,0" />
                <TextBlock Text="Your PC, understood." FontSize="15" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0" />
            </StackPanel>
            <Border HorizontalAlignment="Right" Background="{StaticResource SurfaceBrush}" CornerRadius="12" Padding="16,10">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="8" Height="8" Fill="#4ADE80" VerticalAlignment="Center" />
                    <TextBlock Text=" Local engine ready" Foreground="{StaticResource MutedBrush}" Margin="8,0,0,0" />
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource SurfaceBrush}" CornerRadius="18" Padding="26">
                <StackPanel>
                    <TextBlock Text="Nova Score" FontSize="15" Foreground="{StaticResource MutedBrush}" />
                    <TextBlock Text="--" FontSize="64" FontWeight="SemiBold" Margin="0,8,0,0" />
                    <TextBlock Text="Run your first scan to build your Farla profile." Foreground="{StaticResource MutedBrush}" Margin="0,0,0,24" />
                    <Button Content="Start PC Scan" Height="48" HorizontalAlignment="Left" Padding="28,0" Background="{StaticResource AccentBrush}" Foreground="White" BorderThickness="0" />
                </StackPanel>
            </Border>

            <StackPanel Grid.Column="2">
                <Border Background="{StaticResource SurfaceBrush}" CornerRadius="18" Padding="22" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="PC Health" FontSize="15" Foreground="{StaticResource MutedBrush}" />
                        <TextBlock Text="Not scanned" FontSize="23" FontWeight="SemiBold" Margin="0,8,0,0" />
                        <TextBlock Text="Diagnostics will appear here." Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
                <Border Background="{StaticResource SurfaceBrush}" CornerRadius="18" Padding="22">
                    <StackPanel>
                        <TextBlock Text="Recent activity" FontSize="15" Foreground="{StaticResource MutedBrush}" />
                        <TextBlock Text="No changes made" FontSize="20" FontWeight="SemiBold" Margin="0,8,0,0" />
                        <TextBlock Text="Farla will keep an auditable history of every optimization." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
