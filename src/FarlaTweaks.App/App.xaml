<Application x:Class="FarlaTweaks.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="NovaBackground" Color="#0B0D12" />
        <SolidColorBrush x:Key="NovaSurface" Color="#121722" />
        <SolidColorBrush x:Key="NovaText" Color="#F4F7FB" />
        <SolidColorBrush x:Key="NovaMuted" Color="#8994A6" />
        <SolidColorBrush x:Key="NovaAccent" Color="#7C5CFF" />
    </Application.Resources>
</Application>
