<Application x:Class="FarlaTweaks.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="BackgroundBrush" Color="#0B0D11" />
        <SolidColorBrush x:Key="SurfaceBrush" Color="#12161D" />
        <SolidColorBrush x:Key="Surface2Brush" Color="#181D26" />
        <SolidColorBrush x:Key="TextBrush" Color="#F4F7FB" />
        <SolidColorBrush x:Key="MutedBrush" Color="#8E98A8" />
        <SolidColorBrush x:Key="AccentBrush" Color="#7C5CFF" />
    </Application.Resources>
</Application>
